# Mahalli — environment template. Copy to .env.local and fill in.

# --- Supabase (client-safe) ---------------------------------------------
# Project API URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key, format: sb_publishable_... — safe for the browser.
# RLS scopes all access; this key cannot read another tenant's data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of the app (used for auth redirects, storefront links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never sent to the browser) --------------------
# Service-role key. BYPASSES RLS. Used only by trusted server endpoints
# (storefront order creation, payment webhooks, background jobs).
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for the background worker (/api/jobs/worker). Vercel Cron sends
# it automatically as `Authorization: Bearer $CRON_SECRET`. The worker refuses to
# run if this is unset.
CRON_SECRET=

# --- Integrations (Phase 2; leave blank for now) ------------------------
# DPAY_API_KEY=
# DPAY_WEBHOOK_SECRET=
# WHATSAPP_CLOUD_TOKEN=
